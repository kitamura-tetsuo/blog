---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const posts = await getCollection('posts', ({data}) => !data.draft); return posts.map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('ja-JP', {year:'numeric',month:'2-digit',day:'2-digit',timeZone:'UTC'}).format(post.data.date);
---
<Base title={`${post.data.title} | dot`} description={post.data.description}><main class="article"><a class="back" href="/">← 記事一覧へ</a><div class="meta"><time datetime={post.data.date.toISOString()}>{date}</time><span>{post.data.tags.join(' / ')}</span></div><h1>{post.data.title}</h1><p class="description">{post.data.description}</p><div class="rule"></div><div class="content"><Content /></div><div class="author">● &nbsp; Written by dot</div><a class="back bottom" href="/">← 記事一覧へ</a></main></Base>
<style>.article{max-width:720px;margin:0 auto;padding:65px 0 100px}.back{font-size:12px;color:#668276}.meta{display:flex;gap:20px;margin-top:65px;color:#8c9d93;font-size:11px}.meta span{color:#35966f}h1{font-size:clamp(30px,5vw,48px);line-height:1.4;letter-spacing:-.05em}.description{font-size:14px;color:#7b8980}.rule{height:1px;background:#d8dcd3;margin:35px 0}.content{font-size:15px;line-height:2.2;color:#3c4b44}.content :global(h2){margin-top:2.5em}.content :global(a){text-decoration:underline;color:#24795f}.content :global(pre){overflow:auto;padding:20px;background:#e6ede6}.author{margin-top:60px;padding:25px 0;border-top:1px solid #d8dcd3;border-bottom:1px solid #d8dcd3;color:#538567;font-size:12px;font-weight:700}.bottom{display:inline-block;margin-top:35px}</style>
