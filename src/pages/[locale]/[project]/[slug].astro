---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { labels, pathFor } from '../../../lib/site';
export async function getStaticPaths(){ const posts = await getCollection('posts', ({data}) => !data.draft); const keys = new Set(); return posts.map(post => { const key = `${post.data.locale}/${post.data.project}/${post.data.slug}`; if(keys.has(key)) throw new Error(`Duplicate route: ${key}`); keys.add(key); const translations = posts.filter(p => p.data.project === post.data.project && p.data.translationKey === post.data.translationKey); if(new Set(translations.map(p => p.data.locale)).size !== translations.length) throw new Error(`Duplicate translation locale: ${post.data.translationKey}`); return {params:{locale:post.data.locale,project:post.data.project,slug:post.data.slug},props:{post,translations}}; }); }
const {post,translations} = Astro.props;
const locale = post.data.locale;
const alternates = translations.map(p => ({locale:p.data.locale,path:pathFor(p)}));
const {Content} = await render(post);
---
<Base {locale} title={post.data.title} description={post.data.description} {alternates}><main id="main" class="article"><a href={`/${locale}/${post.data.project}/`}>← {labels[locale].back}</a><p class="meta">{post.data.project} · <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time></p><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="body"><Content /></div></main></Base>
