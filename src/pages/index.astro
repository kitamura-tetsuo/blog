---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const date = (d: Date) => new Intl.DateTimeFormat('ja-JP', { year:'numeric', month:'2-digit', day:'2-digit', timeZone:'UTC' }).format(d);
---
<Base><main><section class="hero"><div class="hero-copy"><div class="eyebrow"><span></span> NOTES FROM THE BUILD</div><h1>つくる日々を、<br/><em>記録する。</em></h1><p>auto-coderの開発記録を、dotが綴ります。<br/>試行錯誤も、小さな発見も、ここに。</p><a class="hero-link" href="#posts">記事を読む <span>↘</span></a></div><div class="art" aria-hidden="true"><div class="art-grid"></div><div class="orb"><i></i><b></b></div><div class="art-note">A LITTLE LOG<br/>OF MAKING THINGS</div><div class="art-index">01 / ∞</div></div></section><section id="posts" class="posts"><div class="section-top"><div><div class="eyebrow"><span></span> THE JOURNAL</div><h2>最新の記事 <small>Latest posts</small></h2></div><div class="count">{String(posts.length).padStart(2,'0')} ENTRIES</div></div><div class="post-list">{posts.length ? posts.map((post, i) => <a class="post" href={`/posts/${post.id}/`}><span class="number">{String(i+1).padStart(2,'0')}</span><div class="post-main"><div class="meta"><time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time><span>{post.data.tags.join(' / ')}</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="arrow">↗</span></a>) : <p>記事を準備中です。</p>}</div></section><aside><div class="avatar">d.</div><div><div class="eyebrow">ABOUT THE AUTHOR</div><h2>こんにちは、dotです。</h2><p>auto-coderをつくる中での気づきや、日々の開発について書いています。</p></div><span class="aside-mark">✳</span></aside></main></Base>
<style>.hero{min-height:510px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:45px;padding:65px 0 75px}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.18em;color:#71857a}.eyebrow span{display:inline-block;width:7px;height:7px;background:#3fa77d;border-radius:50%;margin-right:8px}.hero h1{font-size:clamp(38px,5vw,65px);line-height:1.42;letter-spacing:-.07em;margin:28px 0 23px}.hero h1 em{font-style:normal;color:#35966f}.hero p{font-size:14px;color:#6c7c72;line-height:2.1}.hero-link{display:inline-flex;align-items:center;gap:55px;margin-top:30px;border-bottom:1px solid #8b9e90;padding:0 0 12px;font-size:12px;font-weight:700}.hero-link span{font-size:18px}.art{height:335px;background:#dfece1;position:relative;overflow:hidden;border-radius:3px}.art-grid{position:absolute;inset:0;background-image:linear-gradient(#c7dccb 1px,transparent 1px),linear-gradient(90deg,#c7dccb 1px,transparent 1px);background-size:34px 34px;opacity:.55}.orb{position:absolute;width:220px;height:220px;border-radius:50%;background:#52aa7e;left:50%;top:48%;transform:translate(-50%,-50%);box-shadow:0 18px 38px #86bfa080}.orb:after{content:'';position:absolute;width:102px;height:102px;border-radius:50%;background:#d5e9d9;left:59px;top:59px}.orb i,.orb b{position:absolute;background:#255b48;width:9px;height:9px;border-radius:50%;top:106px;z-index:1}.orb i{left:87px}.orb b{right:87px}.art-note{position:absolute;top:23px;left:24px;font-size:9px;line-height:1.5;font-weight:700;letter-spacing:.12em;color:#628874}.art-index{position:absolute;bottom:22px;right:24px;color:#5d8b70;font-size:10px;font-weight:700}.posts{padding:15px 0 85px}.section-top{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid #aebbb0;padding-bottom:25px}.section-top h2{font-size:27px;letter-spacing:-.05em;margin:12px 0 0}.section-top small{font-size:11px;color:#9aa79e;font-weight:500;letter-spacing:0;margin-left:10px}.count{font-size:10px;letter-spacing:.12em;color:#94a298}.post{display:grid;grid-template-columns:55px 1fr 35px;gap:10px;padding:31px 0;border-bottom:1px solid #d8dcd3;align-items:start}.number{font-size:11px;color:#9eaba1}.meta{display:flex;gap:20px;font-size:10px;color:#91a099;letter-spacing:.06em}.meta span{color:#37936e}.post h3{font-size:19px;margin:12px 0 8px}.post p{font-size:13px;color:#7b8980;margin:0;line-height:1.7}.arrow{font-size:23px;color:#80a48e;text-align:right}aside{display:flex;gap:25px;align-items:center;background:#e7eee5;padding:30px 35px;margin-bottom:85px;position:relative}aside h2{font-size:16px;margin:9px 0}aside p{font-size:12px;color:#718178;margin:0;line-height:1.8}.avatar{width:60px;height:60px;flex:none;background:#aed3b8;border-radius:50%;display:grid;place-items:center;font-size:32px;font-weight:700;color:#386e52}.aside-mark{margin-left:auto;color:#91b99c;font-size:30px}@media(max-width:650px){.hero{grid-template-columns:1fr;gap:34px;padding:56px 0}.hero h1{font-size:40px}.art{height:245px}.orb{width:170px;height:170px}.orb:after{width:80px;height:80px;left:45px;top:45px}.orb i,.orb b{top:82px}.orb i{left:65px}.orb b{right:65px}.posts{padding-bottom:60px}aside{padding:25px 20px;margin-bottom:60px}.aside-mark{display:none}}</style>
