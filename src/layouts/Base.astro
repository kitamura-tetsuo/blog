---
import { labels } from '../lib/site';
const { locale = 'en', title = labels[locale].title, description = labels[locale].intro, alternates = [] } = Astro.props;
const canonical = new URL(Astro.props.canonicalPath || Astro.url.pathname, Astro.site);
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.path, Astro.site)}/>)}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title} | dot</title></head><body><a class="skip" href="#main">{locale === 'ja' ? '本文へ' : 'Skip to content'}</a><div class="site"><header><a class="brand" href={`/${locale}/`}>● dot <small>/ development log</small></a><nav aria-label={labels[locale].language}>{alternates.map((a) => <a href={a.path} hreflang={a.locale} lang={a.locale} aria-current={a.locale === locale ? 'page' : undefined}>{a.locale === 'ja' ? '日本語' : 'English'}</a>)}</nav></header><slot/><footer>● dot <span>— Development notes</span></footer></div></body></html>
<style is:global>
:root{font-family:system-ui,sans-serif;color:#20302a;background:#f5f4ef;line-height:1.7}*{box-sizing:border-box}body{margin:0}a{color:#16674c;text-underline-offset:.2em}a:hover{color:#123d30}a:focus-visible{outline:3px solid #a6551d;outline-offset:4px}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:white;z-index:2}.site{max-width:1050px;margin:auto;padding:0 32px}header,footer{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:24px 0;border-bottom:1px solid #c6d2c8}footer{border-top:1px solid #c6d2c8;border-bottom:0;margin-top:5rem;color:#49665a}.brand{font-size:1.4rem;font-weight:750;text-decoration:none}.brand small{font-size:.7rem;color:#52685d}nav{display:flex;gap:1rem;flex-wrap:wrap}main{min-height:55vh}h1,h2,h3{line-height:1.25;color:#172e24}h1{font-size:clamp(2.4rem,6vw,4.5rem);letter-spacing:-.04em}p{max-width:65ch}.eyebrow{font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:#42755d;font-weight:700}.hero{padding:5rem 0 4rem}.hero p{font-size:1.2rem}.projects{display:flex;gap:.6rem;flex-wrap:wrap;margin:1.5rem 0 4rem}.projects a{padding:.5rem 1rem;border:1px solid #9fb7a5;border-radius:3rem}.entries{border-top:1px solid #a8b8aa}.entry{display:block;padding:1.5rem 0;border-bottom:1px solid #ccd7cd;text-decoration:none}.entry h2{font-size:1.45rem;margin:.4rem 0}.entry p{color:#465e51;margin:.4rem 0}.meta{font-size:.8rem;color:#526f60}.article{max-width:740px;margin:auto;padding-top:4rem}.article h1{font-size:clamp(2rem,5vw,3.5rem)}.article .body{font-size:1.05rem;line-height:1.9;overflow-wrap:anywhere}.article h2{margin-top:2.5em}.article pre{overflow:auto;background:#e2ebe2;padding:1rem}@media(max-width:600px){.site{padding:0 20px}header{align-items:flex-start}.brand small{display:none}.hero{padding:3rem 0 2rem}.projects{margin-bottom:2rem}.article{padding-top:2rem}}
</style>
