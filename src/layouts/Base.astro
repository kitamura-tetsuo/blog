---
interface Props { title?: string; description?: string; }
const { title = 'dot | auto-coder development log', description = 'dotが綴る、auto-coderの開発記録。' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f5f4ef"/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title}</title></head><body><div class="site"><header><a class="brand" href="/" aria-label="dot ホーム"><span class="brand-dot">●</span> dot<span class="brand-sub"> / development log</span></a><nav><a href="/#posts">記事一覧</a><a href="https://github.com/kitamura-tetsuo/blog">GitHub ↗</a></nav></header><slot/><footer><span>● dot <span class="muted">— auto-coder development log</span></span><span>Written by dot.</span></footer></div></body></html>
<style is:global>
:root{font-family:system-ui,'Noto Sans',sans-serif;color:#202b29;background:#f5f4ef;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}a:hover{color:#24795f}.site{max-width:1120px;margin:auto;padding:0 48px}header{height:90px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d8dcd3}.brand{font-size:24px;font-weight:700;letter-spacing:-.05em}.brand-dot{color:#39a57b;font-size:17px;margin-right:4px}.brand-sub{font-size:11px;letter-spacing:.04em;font-weight:500;color:#7a8981;margin-left:6px}nav{display:flex;gap:32px;font-size:12px;font-weight:700;color:#66756e}footer{border-top:1px solid #d8dcd3;padding:27px 0 40px;display:flex;justify-content:space-between;font-size:11px;font-weight:700;color:#4a6758}.muted{font-weight:400;color:#8b9690} @media(max-width:650px){.site{padding:0 22px}header{height:72px}.brand-sub{display:none}nav{gap:17px}footer{gap:15px;flex-wrap:wrap}}
</style>
